# Public Vite variables: set these in Vercel and rebuild after changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional public-key alias when PUBLISHABLE_KEY is unset; never a service key.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Server-only: configure in Lovable Cloud secrets, NOT VITE_ variables.
# Empty values intentionally disable checkout; no fake payments or access grants.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_MONTHLY_PLAN_ID=
FLUTTERWAVE_ANNUAL_PLAN_ID=